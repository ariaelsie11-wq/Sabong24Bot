# Get this from @BotFather on Telegram
BOT_TOKEN=

# UTC hour (0-23) the daily tip/quote/starter push goes out to subscribers.
# Default 13 = 1pm UTC (~9am US Eastern, ~6am US Pacific, ~2pm UK).
DAILY_HOUR_UTC=13

# Optional: point at a Railway Volume mount path so subscriber lists survive
# redeploys, e.g. /data. Defaults to local disk (resets on redeploy).
DATA_DIR=
